\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ailab-preprint}[2026/11/17 VUB AI research preprints]
% Optional branding: \usepackage[triangle]{ailab-preprint}.
\newif\ifailab@triangle
\DeclareOption{triangle}{\ailab@triangletrue}
\DeclareOption{notriangle}{\ailab@trianglefalse}
\ProcessOptions\relax
% Shared design: researchers normally only edit their .tex and .bib files.
\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{ailab-preprint}{Use LuaLaTeX}{In Overleaf, open Settings > Compiler and choose LuaLaTeX.}
  \expandafter\endinput
\fi
\RequirePackage[a4paper,margin=25mm,top=23mm,bottom=25mm,footskip=12mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{amsmath,amsthm}
\RequirePackage{unicode-math}
\setmainfont{Libertinus Serif}
\setmathfont{Libertinus Math}
\setsansfont{Libertinus Sans}
% Use the VUB title font from the project, making Overleaf independent of
% local font installation. The official binary must be supplied separately.
\IfFileExists{fonts/ITCAvantGardePro-Bold.otf}{%
  \newfontfamily\ailabtitlefont{ITCAvantGardePro-Bold.otf}[Path=fonts/]
}{%
  \IfFontExistsTF{ITC Avant Garde Gothic Pro Bold}{%
    \newfontfamily\ailabtitlefont{ITC Avant Garde Gothic Pro Bold}
  }{%
    \newfontfamily\ailabtitlefont{texgyreadventor-bold.otf}
    \PackageInfo{ailab-preprint}{ITC Avant Garde not supplied; using TeX Gyre Adventor}
  }
}
\setmonofont{Latin Modern Mono}[Scale=MatchLowercase]
\RequirePackage[english]{babel}
\RequirePackage{microtype}
\RequirePackage{ragged2e}
\RequirePackage{xcolor}
% VUB guide, PDF page 13 / printed page 18. Use the printed HEX values;
% the secondary-color RGB and HEX specifications in that guide differ.
\definecolor{VUBBlue}{HTML}{003399}
\definecolor{VUBOrange}{HTML}{FF6600}
\definecolor{VUBGrayBlue}{HTML}{E8EBF1}
\definecolor{VUBAqua}{HTML}{E8F2F2}
\definecolor{VUBGray}{HTML}{979797}
\RequirePackage{graphicx}
\RequirePackage{booktabs,tabularx,longtable,array,multirow}
\RequirePackage{siunitx}
\sisetup{detect-all,group-separator={\,},group-minimum-digits=4,
  separate-uncertainty=true,table-number-alignment=center}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}
\captionsetup{justification=raggedright,singlelinecheck=false,skip=6pt}
\captionsetup[table]{position=top}
\RequirePackage{subcaption}
\RequirePackage[ruled,vlined]{algorithm2e}
\DontPrintSemicolon
\SetAlCapFnt{\small}\SetAlCapNameFnt{\small\bfseries}
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=1.5em,topsep=5pt}
\RequirePackage{titlesec}
\titleformat{\section}{\sffamily\large\bfseries\color{VUBBlue}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\sffamily\normalsize\bfseries}{\thesubsection}{0.7em}{}
\titleformat{\subsubsection}{\sffamily\normalsize\itshape}{\thesubsubsection}{0.7em}{}
\titlespacing*{\section}{0pt}{2.1ex plus .6ex minus .3ex}{.8ex}
\titlespacing*{\subsection}{0pt}{1.7ex plus .5ex minus .2ex}{.5ex}
\RequirePackage{fancyhdr}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\sffamily\small\thepage}
\setlength{\headheight}{14pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt minus 1pt}
\linespread{1.06}
\setlength{\emergencystretch}{1.5em}
\clubpenalty=10000 \widowpenalty=10000
\raggedbottom
\setlength{\textfloatsep}{14pt plus 3pt minus 2pt}
\setlength{\intextsep}{12pt plus 3pt minus 2pt}
\renewcommand{\topfraction}{.9}\renewcommand{\bottomfraction}{.8}
\renewcommand{\textfraction}{.1}\renewcommand{\floatpagefraction}{.75}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\lstdefinestyle{latexexample}{language=[LaTeX]TeX,basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{VUBBlue},commentstyle=\itshape\color{black!55},
  breaklines=true,columns=fullflexible,keepspaces=true,showstringspaces=false,
  frame=single,rulecolor=\color{VUBGrayBlue},framesep=6pt,
  xleftmargin=7pt,xrightmargin=7pt,aboveskip=9pt,belowskip=9pt}
\lstset{style=latexexample}
\RequirePackage[authoryear,round]{natbib}
\setlength{\bibsep}{4pt}
\RequirePackage{xurl}
\RequirePackage[colorlinks=true,allcolors=VUBBlue,unicode=true]{hyperref}
\pdfstringdefDisableCommands{\def\\{ }\def\affil#1{}\def\thanks#1{}}
\urlstyle{same}
\RequirePackage[nameinlink,noabbrev,capitalise]{cleveref}
\crefname{algocf}{Algorithm}{Algorithms}
\Crefname{algocf}{Algorithm}{Algorithms}
% Theorem-like environments share a section-local counter.
\RequirePackage{aliascnt}
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
% Separate alias counters preserve object names in cleveref while sharing numbers.
\newcommand{\ailab@newtheorem}[2]{%
  \newaliascnt{#1}{theorem}%
  \newtheorem{#1}[#1]{#2}%
  \aliascntresetthe{#1}%
  \crefname{#1}{#2}{#2s}%
  \Crefname{#1}{#2}{#2s}}
\ailab@newtheorem{lemma}{Lemma}
\ailab@newtheorem{proposition}{Proposition}
\ailab@newtheorem{corollary}{Corollary}
\crefname{corollary}{Corollary}{Corollaries}
\Crefname{corollary}{Corollary}{Corollaries}
\ailab@newtheorem{conjecture}{Conjecture}
\theoremstyle{definition}
\ailab@newtheorem{definition}{Definition}
\ailab@newtheorem{assumption}{Assumption}
\theoremstyle{remark}
\ailab@newtheorem{remark}{Remark}
\ailab@newtheorem{example}{Example}
% Metadata. Blank optional fields disappear without leaving empty rows.
\newcommand{\ailab@affiliations}{}
\newcommand{\ailab@abstract}{}
\newcommand{\ailab@keywords}{}
\newcommand{\ailab@note}{}
\newcommand{\affiliations}[1]{\gdef\ailab@affiliations{#1}}
\newcommand{\preprintabstract}[1]{\gdef\ailab@abstract{#1}}
\newcommand{\keywords}[1]{\gdef\ailab@keywords{#1}}
\newcommand{\preprintnote}[1]{\gdef\ailab@note{#1}}
\newcommand{\affil}[1]{\textsuperscript{#1}}
\date{} % Explicit version dates only; no automatically changing date.
\newcommand{\ailab@optional}[2]{\ifx#2\@empty\else
  \par\vspace{3pt}{\small\textbf{#1}\space #2\par}\fi}
% The guide's triangle has a horizontal top, vertical right edge, and
% a diagonal at 69.25 degrees: width / height = tan(20.75 deg).
\newsavebox{\ailab@titlebox}
\newcommand{\ailab@printtitle}{%
  \ifailab@triangle
    \sbox{\ailab@titlebox}{\begin{minipage}[t]{\dimexpr\linewidth-13mm\relax}
      \raggedright\ailabtitlefont\color{VUBBlue}\fontsize{25}{28}\selectfont
      \@title\par
    \end{minipage}}%
    \noindent\raisebox{\dimexpr\ht\ailab@titlebox-18mm\relax}{%
      \begin{tikzpicture}[baseline=0pt]
        \fill[VUBOrange] (0,18mm)--(6.82mm,18mm)--(6.82mm,0)--cycle;
      \end{tikzpicture}}\hspace{6.18mm}\usebox{\ailab@titlebox}\par
  \else
    {\ailabtitlefont\color{VUBBlue}\fontsize{25}{28}\selectfont\@title\par}%
  \fi
}
\renewcommand{\maketitle}{%
  \begingroup
  \hypersetup{pdftitle={\@title},pdfauthor={\@author}}
  \begin{tcolorbox}[enhanced,breakable,colback=VUBGrayBlue!55!white,
    colframe=VUBGrayBlue!55!white,boxrule=0pt,arc=4mm,
    left=7mm,right=7mm,top=6mm,bottom=6mm,
    before skip=0pt,after skip=15pt,pad at break*=3mm]
    \raggedright
    \ailab@printtitle
    \vspace{11pt}
    {\large\@author\par}
    \ifx\ailab@affiliations\@empty\else
      \vspace{5pt}{\small\ailab@affiliations\par}\fi
    \ifx\@date\@empty\else\vspace{5pt}{\small\@date\par}\fi
    \ailab@optional{}{\ailab@note}
  \end{tcolorbox}
  \ifx\ailab@abstract\@empty\else
    {\sffamily\small\bfseries\color{VUBBlue}Abstract\par}\nobreak
    \vspace{3pt}{\justifying\setlength{\parindent}{0pt}\normalsize\ailab@abstract\par}
  \fi
  \ailab@optional{Keywords:}{\ailab@keywords}
  \par\vspace{10pt}
  \endgroup
}
\endinput
